# ============================================================
# .gitignore
# ============================================================

# --- C++ (server/) -------------------------------------------------

# CMake build directories
build*/
cmake-build-*/
install*/
results*/
# server/data/

# Locally generated CMake presets (machine-specific paths,
# regenerated every configure — never something to commit)
CMakeUserPresets.json

# Object files
*.o
*.obj

# Executables
*.exe

# Debug symbols
*.pdb

# Static / shared libraries
*.a
*.lib
*.so
*.dll

# Coverage files
*.gcda
*.gcno
*.gcov
coverage.info
coverage.filtered.info
coverage-html/

# --- Frontend (frontend/) -------------------------------------------

node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*

# Local env overrides — e.g. a different METRICS_URL for someone's
# machine. Never something to commit; everyone should set their own.
frontend/.env.local
frontend/.env.*.local

# --- Docs (docs/) ----------------------------------------------------

# Doxygen (fetched theme + generated output, not committed)
docs/doxygen-awesome-css/
docs/html/

# --- Tooling ----------------------------------------------------------

# Clang tools
.clangd/
.cache/

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Release tarballs (downloaded locally for hash verification)
*.tar.gz

# NOTE: server/third_party/falconhttp/ and server/third_party/minidb/
# are git submodules (see .gitmodules), not build artifacts — they
# should NOT be ignored. Their own build output still lands under
# build*/ above once configured, same as everything else.
