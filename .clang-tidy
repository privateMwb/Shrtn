# ============================================================
# .clang-tidy
#
# Without this file, clang-tidy falls back to its full default
# check set -- which includes checks that actively conflict with
# conventions already used consistently across this codebase, not
# just in one file. Disabled below for that reason, with the
# specific conflict noted for each:
#
#   readability-named-parameter
#     Every route handler in server/src/routes/ takes unnamed,
#     unused HttpRequest/HttpResponse params by convention (e.g.
#     `getLinks(ShrtnDb&, const HttpRequest&, HttpResponse&)`).
#     Enabling this fights that convention everywhere, not just
#     once.
#
#   readability-identifier-naming
#     No naming convention is documented for this project, and
#     the default (PascalCase namespaces) conflicts with the
#     existing lowercase `namespace detail { ... }` convention
#     already in use.
#
#   performance-enum-size
#     Backing-type micro-optimization for enums. Not an adopted
#     convention here or in FalconHTTP/MiniDB's own enums --
#     adopting it now means either a sweeping, low-value change
#     across the whole ecosystem, or an inconsistency between
#     Shrtn's enums and the libraries it's built on.
#
#   bugprone-easily-swappable-parameters
#     Flags any 3+ same-typed adjacent string params (e.g.
#     tryInsertUrl's code/originalUrl/createdAt). Real concern in
#     principle, but fixing it means restructuring signatures
#     (tag types or a struct) across multiple functions -- a
#     deliberate design change, not a lint fix. Worth doing later
#     as its own change, not silently via a tidy pass.
#
#   readability-magic-numbers
#     Fires on `50` and `400` inside Metrics.h/MetricsJson.h --
#     copied-unchanged files that can never be edited to satisfy
#     it, which settles this regardless of what's done with
#     Shrtn's own literals (e.g. main.cpp's 200/8080).
#
#   readability-identifier-length
#     Fires on `t`, `fn`, `ms` inside the copied files, and on
#     idiomatic short names used consistently in Shrtn's own code
#     (`db`, `id`, `s`, `c`) for tightly-scoped, obvious-context
#     locals -- not a naming problem, a style already in use
#     everywhere.
#
#   misc-non-private-member-variables-in-classes
#     Fires on MetricEntry's public fields in Metrics.h -- a
#     plain data struct by design, in a file that can't be
#     restructured.
#
#   misc-include-cleaner
#     Fights the project's own `rain::` umbrella-namespace
#     convention, which deliberately exposes symbols transitively
#     through each library's main header rather than requiring
#     every consumer to include the originating header directly.
#     Enabling this fights an intentional architecture decision,
#     not an oversight.
#
# Everything else uses clang-tidy's defaults. If a future warning
# turns out to be more default-set noise than a real conflict
# worth living with, add it above with the same reasoning --
# don't just silence it without a note.
# ============================================================

Checks: >
  clang-diagnostic-*,
  clang-analyzer-*,
  bugprone-*,
  misc-*,
  performance-*,
  readability-*,
  -readability-named-parameter,
  -readability-identifier-naming,
  -performance-enum-size,
  -bugprone-easily-swappable-parameters,
  -readability-magic-numbers,
  -readability-identifier-length,
  -misc-non-private-member-variables-in-classes,
  -misc-include-cleaner

WarningsAsErrors: '*'
HeaderFilterRegex: '(server/include|server/src)/.*'
